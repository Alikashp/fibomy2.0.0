# Все переменные окружения проекта. Скопируйте в .env для локального запуска.
# Читаются только через src/config.py (Settings); имена — без учёта регистра.
# Реальные значения секретов в репозиторий НЕ коммитим.

# Сервисы Railway (один образ): процесс выбирает SERVICE_ROLE (src/start.py, D-062).
# Каким сервисам какие переменные нужны:
#   бот:    TELEGRAM_BOT_TOKEN, DATABASE_URL, REDIS_URL, ADMIN_TELEGRAM_IDS (+ S3_* при наличии)
#   воркер: всё, кроме API_*
#   api:    DATABASE_URL, REDIS_URL, API_PUBLIC_URL (+ S3_* при наличии)

# Роль сервиса: bot (по умолчанию) | worker | api. Задаётся в каждом сервисе Railway.
SERVICE_ROLE=bot

# ── Telegram (бот и воркер) ───────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# Админ-команды бота (/apikey — ключи REST API): Telegram ID владельцев через запятую.
# Свой ID присылает бот @userinfobot. Пусто — команды недоступны никому. Нужна боту.
ADMIN_TELEGRAM_IDS=

# ── LLM (OpenAI-совместимый API) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o
# Уровень рассуждений для моделей с рассуждениями (gpt-6-luna: none, low, medium,
# high, xhigh, max). Моделям без рассуждений (gpt-4o, gpt-4o-mini) не передаётся.
# Какие параметры принимает модель и её цены — prompts/models.yaml.
OPENAI_REASONING_EFFORT=low
# Таймаут одного запроса к LLM, секунды
OPENAI_TIMEOUT_SECONDS=45

# ── Новый движок: этапы LLM, параллелизм, дедлайн ─────────────────────────
# Модель и уровень рассуждений по этапам; пусто — OPENAI_MODEL / OPENAI_REASONING_EFFORT
LLM_MODEL_OUTLINE=
LLM_MODEL_CONTENT=
LLM_EFFORT_OUTLINE=
LLM_EFFORT_CONTENT=
# auto — json_schema strict, при отказе провайдера json_object; или json_schema / json_object
LLM_STRUCTURED_OUTPUTS=auto
LLM_MAX_CONCURRENCY=16
CONTENT_CONCURRENCY=8
LIBREOFFICE_MAX_PARALLEL=2
DECK_DEADLINE_SECONDS=110

# ── Тарифы ────────────────────────────────────────────────────────────────
WATERMARK_FREE_TIER=true

# ── PostgreSQL (Railway отдаёт postgres://..., код сам переводит в asyncpg) ─
# Пусто = бот и воркер работают без БД
DATABASE_URL=

# ── Redis: очередь ARQ, кэш картинок ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Картинки (нужен хотя бы один ключ) ────────────────────────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── S3-совместимое хранилище (R2, Yandex Object Storage, Selectel, MinIO; ─
# пусто = не используется). Код не зависит от провайдера (D-042).
# Файлы колод API: с S3 — бакет, префикс decks/ (ссылки живут 24 ч, правило
# жизненного цикла бакета на decks/ — 2 дня); без S3 — Redis на 1 час (D-058).
# Задаются одинаково у воркера и api: воркер кладёт файлы, api отдаёт.
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fibonacci-presentations
S3_REGION=us-east-1

# ── REST API (сервис api, docs/API.md) ────────────────────────────────────
# Публичный адрес сервиса api (Settings → Networking → домен), без / в конце.
# Нужен воркеру — ссылки на файлы в теле webhook; api без него берёт адрес из запроса.
API_PUBLIC_URL=
# Максимальный размер файла материала, МБ
API_MAX_FILE_MB=20
