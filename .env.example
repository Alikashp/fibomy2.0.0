# Все переменные окружения проекта. Скопируйте в .env для локального запуска.
# Читаются только через src/config.py (Settings); имена — без учёта регистра.
# Реальные значения секретов в репозиторий НЕ коммитим.

# ── Telegram ──────────────────────────────────────────────────────────────
TELEGRAM_BOT_TOKEN=

# ── LLM (OpenAI-совместимый API) ──────────────────────────────────────────
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.proxyapi.ru/openai/v1
OPENAI_MODEL=gpt-4o
# Уровень рассуждений для моделей с рассуждениями (gpt-6-luna: none, low, medium,
# high, xhigh, max). Моделям без рассуждений (gpt-4o, gpt-4o-mini) не передаётся.
# Какие параметры принимает модель и её цены — prompts/models.yaml.
OPENAI_REASONING_EFFORT=low
# Таймаут одного запроса к LLM, секунды
OPENAI_TIMEOUT_SECONDS=45

# ── Новый движок: этапы LLM, параллелизм, дедлайн ─────────────────────────
# Модель и уровень рассуждений по этапам; пусто — OPENAI_MODEL / OPENAI_REASONING_EFFORT
LLM_MODEL_OUTLINE=
LLM_MODEL_CONTENT=
LLM_EFFORT_OUTLINE=
LLM_EFFORT_CONTENT=
# auto — json_schema strict, при отказе провайдера json_object; или json_schema / json_object
LLM_STRUCTURED_OUTPUTS=auto
LLM_MAX_CONCURRENCY=16
CONTENT_CONCURRENCY=8
LIBREOFFICE_MAX_PARALLEL=2
DECK_DEADLINE_SECONDS=110

# ── Тарифы ────────────────────────────────────────────────────────────────
WATERMARK_FREE_TIER=true

# ── PostgreSQL (Railway отдаёт postgres://..., код сам переводит в asyncpg) ─
# Пусто = бот и воркер работают без БД
DATABASE_URL=

# ── Redis: очередь ARQ, кэш картинок ──────────────────────────────────────
REDIS_URL=redis://localhost:6379/0

# ── Картинки (нужен хотя бы один ключ) ────────────────────────────────────
UNSPLASH_ACCESS_KEY=
PEXELS_API_KEY=

# ── S3-совместимое хранилище (R2, Yandex Object Storage, Selectel, MinIO; ─
# пусто = не используется). Код не зависит от провайдера (D-042).
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=fibonacci-presentations
S3_REGION=us-east-1
