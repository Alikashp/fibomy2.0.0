{
 "paths": {
  "/v1/decks": {
   "post": {
    "operationId": "create_deck_v1_decks_post",
    "requestBody": {
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/DeckCreate"
       }
      },
      "multipart/form-data": {
       "schema": {
        "properties": {
         "file": {
          "description": ".pdf, .docx, .pptx или .txt до 20 МБ",
          "format": "binary",
          "type": "string"
         },
         "params": {
          "description": "DeckCreate в JSON",
          "type": "string"
         }
        },
        "required": [
         "params"
        ],
        "type": "object"
       }
      }
     },
     "required": true
    },
    "responses": {
     "200": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DeckStatus"
        }
       }
      },
      "description": "Повтор с тем же Idempotency-Key"
     },
     "202": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/DeckStatus"
        }
       }
      },
      "description": "Successful Response"
     },
     "400": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Bad Request"
     },
     "401": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Unauthorized"
     },
     "413": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Request Entity Too Large"
     },
     "429": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Too Many Requests"
     },
     "503": {
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/ErrorResponse"
        }
       }
      },
      "description": "Service Unavailable"
     }
    },
    "summary": "Create Deck",
    "tags": [
     "decks"
    ]
   }
  },
